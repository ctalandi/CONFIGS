# Caparmor  SGI  at Ifremer
#
# NCDF_HOME   root directory containing lib and include subdirectories for netcdf4
# HDF5_HOME   root directory containing lib and include subdirectories for HDF5
# XIOS_HOME   root directory containing lib for XIOS
# OASIS_HOME  root directory containing lib for OASIS
#
# NCDF_INC    netcdf4 include file
# NCDF_LIB    netcdf4 library
# XIOS_INC    xios include file    (taken into accound only if key_iomput is activated)
# XIOS_LIB    xios library         (taken into accound only if key_iomput is activated)
# OASIS_INC   oasis include file   (taken into accound only if key_oasis3 is activated)
# OASIS_LIB   oasis library        (taken into accound only if key_oasis3 is activated)
#
# FC          Fortran compiler command
# FCFLAGS     Fortran compiler flags
# FFLAGS      Fortran 77 compiler flags
# LD          linker
# LDFLAGS     linker flags, e.g. -L<lib dir> if you have libraries
# FPPFLAGS    pre-processing flags
# AR          assembler
# ARFLAGS     assembler flags
# MK          make
# USER_INC    complete list of include files
# USER_LIB    complete list of libraries to pass to the linker
#
# Note that:
#  - unix variables "$..." are accpeted and will be evaluated before calling fcm.
#  - fcm variables are starting with a % (and not a $)
#
%NCDF_HOME           /project/oh/drakkar/LIBRAIRIES/NETCDF/GNU
%HDF5_HOME           /project/oh/drakkar/LIBRAIRIES/NETCDF/GNU
%XIOS_HOME           /project/oh/drakkar/LIBRAIRIES/XIOS2.5/GNU
%OASIS_HOME          

%NCDF_INC            -I%NCDF_HOME/include 
%NCDF_LIB            -L%NCDF_HOME/lib -lnetcdff -L%HDF5_HOME/lib -lnetcdf -lnetcdf -lm -lhdf5_hl -lhdf5 -lm -lz -lsz -lzstd -lcurl
%XIOS_INC            -I%XIOS_HOME/inc 
%XIOS_LIB            -L%XIOS_HOME/lib -lxios -lstdc++
%OASIS_INC           
%OASIS_LIB           

##%CPP	             cpp
##%FC                  mpiifx -c -cpp
###%FCFLAGS             -i4 -r8 -O3 -fp-model strict -fno-alias
##%FCFLAGS             -i4 -r8 -O3 -fp-model precise -fno-alias -traceback 
###%FCFLAGS             -i4 -r8 -O2 -fp-model precise -init=zero -init=arrays -g -fpe0 -traceback 
###%FCFLAGS             -i4 -r8 -g -fpe0 -traceback -CB -O2 -fp-model precise  
##%DEBUG_FCFLAGS       -i4 -r8 -g -O0 -debug all -traceback -fp-model strict -ftrapuv -check all,noarg_temp_created -fpe-all0 -ftz -init=arrays,snan,huge
##%FFLAGS              %FCFLAGS
##%LD                  mpiifx
##%LDFLAGS             -lstdc++ 
##%FPPFLAGS            -P -traditional
#######%FPPFLAGS            -P -C -traditional
##%AR                  ar
##%ARFLAGS             rs
##%MK                  gmake
##%USER_INC            %XIOS_INC %OASIS_INC %NCDF_INC
##%USER_LIB            %XIOS_LIB %OASIS_LIB %NCDF_LIB


%CPP                 cpp -Dkey_nosignedzero 
%FC                  mpifc -fc=gfortran
%DEBUG_FCFLAGS       -fdefault-real-8 -O0 -g -fbacktrace -funroll-all-loops -fcray-pointer -ffree-line-length-none  -Wno-missing-include-dirs -fcheck=all -finit-real=nan
%FCFLAGS        -fdefault-real-8 -O3 -funroll-all-loops -fcray-pointer -ffree-line-length-none -Wno-missing-include-dirs 
%FFLAGS              %FCFLAGS
%LD                  mpifc -fc=gfortran
%LDFLAGS    
%FPPFLAGS            -P -traditional
%AR                  ar
%ARFLAGS             rs
%MK                  gmake
%USER_INC            %XIOS_INC %OASIS_INC %NCDF_INC
%USER_LIB            %XIOS_LIB %OASIS_LIB %NCDF_LIB

%CC                  gcc
%CFLAGS              -O0
